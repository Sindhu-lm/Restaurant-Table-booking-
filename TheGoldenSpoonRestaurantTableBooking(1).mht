lder=3D"Please arrange the table and service as quickly as possible."></tex=
tarea></label>
        <div class=3D"row">
          <button type=3D"button" class=3D"btn btn-outline back">Back</butt=
on>
          <button type=3D"button" class=3D"btn btn-primary next">Review</bu=
tton>
        </div>
      </div>

